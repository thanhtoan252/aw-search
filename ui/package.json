{
  "name": "aw-search-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "sh -c \"npm run tailwind:build && npm run tailwind:watch & ng serve --host 0.0.0.0\"",
    "build": "npm run tailwind:build && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tailwind:build": "tailwindcss -i ./src/styles.tailwind.css -o ./src/tailwind.generated.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles.tailwind.css -o ./src/tailwind.generated.css --watch"
  },
  "dependencies": {
    "@angular/animations": "21.2.14",
    "@angular/cdk": "21.2.13",
    "@angular/common": "21.2.14",
    "@angular/compiler": "21.2.14",
    "@angular/core": "21.2.14",
    "@angular/forms": "21.2.14",
    "@angular/platform-browser": "21.2.14",
    "@angular/router": "21.2.14",
    "@ngrx/signals": "21.1.0",
    "@primeuix/themes": "^2.0.3",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "21.2.14",
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3"
  }
}
